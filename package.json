{
  "name": "ark-pals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "start": "node server/index.mjs",
    "set-password": "node server/set-password.mjs",
    "set-voice-key": "node server/set-voice-key.mjs",
    "set-email-key": "node server/set-email-key.mjs",
    "new-family-link": "node server/new-family-link.mjs",
    "set-stripe-key": "node server/set-stripe-key.mjs",
    "stripe-setup": "node server/stripe-setup.mjs",
    "test": "vitest run",
    "new-island": "node scripts/new-island.mjs",
    "preview:art": "rolldown scripts/preview-pals.tsx --platform node --format esm -o preview/render.mjs && node preview/render.mjs",
    "preview:scenes": "rolldown scripts/preview-scenes.tsx --platform node --format esm -o preview/render-scenes.mjs && node preview/render-scenes.mjs",
    "e2e": "playwright test --project=webkit",
    "e2e:chromium": "playwright test --project=chromium",
    "learning-lines": "rolldown scripts/learning-lines.tsx --platform node --format esm --module-types .css=empty -d preview/learning-lines-build && node preview/learning-lines-build/learning-lines.js"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "22.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
