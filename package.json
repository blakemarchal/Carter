{
  "name": "carters-ark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "start": "node server/index.mjs",
    "set-password": "node server/set-password.mjs",
    "set-voice-key": "node server/set-voice-key.mjs",
    "test": "vitest run",
    "preview:art": "rolldown scripts/preview-pals.tsx --platform node --format esm -o preview/render.mjs && node preview/render.mjs",
    "preview:scenes": "rolldown scripts/preview-scenes.tsx --platform node --format esm -o preview/render-scenes.mjs && node preview/render-scenes.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
