# Carter's Ark Adventure: append to /etc/caddy/Caddyfile (replacing the old spiritflow.church block)
spiritflow.church, www.spiritflow.church {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3004
	header -Server
}

# Ark Pals production (deploy/arkpals-web.service): the paid site
arkpals.world, www.arkpals.world {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3005
	header -Server
}
